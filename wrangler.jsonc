{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intouch",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // S-04: the daily decay-driven reminder sweep. 06:00 UTC = 08:00 CEST /
  // 07:00 CET — chosen for a Poland-only user base, so the hour shifts by one
  // with DST rather than being pinned to local time. Exactly ONE entry: the
  // free plan caps Cron Triggers at 5 per account (not per Worker), so a
  // temporary tight interval for verification must REPLACE this line, never
  // sit alongside it. Non-versioned — apply with `wrangler triggers deploy`
  // or a real `wrangler deploy`, not `versions upload` alone.
  "triggers": {
    "crons": ["0 6 * * *"],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Ephemeral AI job statuses (pending/done/failed). Every write carries an
  // expirationTtl -- see src/lib/ai-jobs.ts, the only file that reads this binding.
  "kv_namespaces": [
    {
      "binding": "AI_JOBS",
      "id": "4765866c5f624d17b235bc614e93acf8",
      "preview_id": "644928899c1c44a881612806f944a321",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
