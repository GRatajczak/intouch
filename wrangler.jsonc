{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intouch",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // F-04: daily reminder-delivery proof send. Non-versioned — apply with
  // `wrangler triggers deploy`, not `versions upload` alone.
  "triggers": {
    "crons": ["0 0 * * *"],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Ephemeral AI job statuses (pending/done/failed). Every write carries an
  // expirationTtl -- see src/lib/ai-jobs.ts, the only file that reads this binding.
  "kv_namespaces": [
    {
      "binding": "AI_JOBS",
      "id": "4765866c5f624d17b235bc614e93acf8",
      "preview_id": "644928899c1c44a881612806f944a321",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
