---
import Topbar from "@/components/Topbar.astro";
import Logo from "@/components/Logo.astro";
import { Button } from "@/components/ui/button";
---

<div class="bg-background min-h-screen w-full">
  <div class="mx-auto max-w-4xl p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto flex max-w-2xl flex-col items-center justify-center px-4 py-24 text-center sm:py-32">
      <Logo size={40} withWordmark class="mb-8" />
      <h1 class="font-display text-display-lg text-foreground mb-6">Bądź blisko osób, na których Ci zależy</h1>
      <p class="text-muted-foreground mb-10 max-w-xl text-lg">
        InTouch pilnuje Twoich relacji i przypomina, zanim ktoś bliski zniknie z Twojego życia.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <Button asChild size="lg">
          <a href="/auth/signin">Zaloguj się</a>
        </Button>
        <Button asChild size="lg" variant="outline">
          <a href="/auth/signup">Zarejestruj się</a>
        </Button>
      </div>
    </div>
  </div>
</div>
