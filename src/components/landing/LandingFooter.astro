---
import Logo from "@/components/Logo.astro";
---

{
  /* Only pages that exist get a link: a footer of dead links is worse than a
    quiet one. Regulamin and Kontakt from the mock join when their pages do. */
}
<footer class="border-border border-t">
  <div
    class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-7 sm:px-8 lg:px-14"
  >
    <div class="flex items-center gap-2.5">
      <Logo size={18} />
      <p class="text-text-tertiary text-[13px]">InTouch · bądź blisko bez pilnowania</p>
    </div>
    <nav aria-label="Informacje prawne">
      <a
        href="/privacy"
        class="text-text-tertiary hover:text-foreground cursor-pointer text-[13px] underline-offset-4 hover:underline"
      >
        Polityka prywatności
      </a>
    </nav>
  </div>
</footer>
