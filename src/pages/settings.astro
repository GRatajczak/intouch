---
import AppShell from "@/components/layout/AppShell.astro";
import DeleteDataSection from "@/components/settings/DeleteDataSection";
import RemindersSection from "@/components/settings/RemindersSection";
import AnalyticsSection from "@/components/settings/AnalyticsSection";
import ApiKeySection from "@/components/settings/ApiKeySection";
import EmailChangeForm from "@/components/settings/EmailChangeForm";
import PasswordChangeForm from "@/components/settings/PasswordChangeForm";
import { buttonVariants } from "@/components/ui/button";
import { createClient } from "@/lib/supabase";
import { loadProfileName } from "@/lib/shell-summary";
import { resolveOwnerKey } from "@/lib/openai-key";

const { user } = Astro.locals;

const profileName = await loadProfileName(Astro.request.headers, Astro.cookies, user?.id);

// Defaults to true so a profile row that predates the S-04 migration -- or a
// signed-up user who never filled the profile form -- renders the switch in the
// same state the sweep will actually read.
const supabase = createClient(Astro.request.headers, Astro.cookies);
// Both toggles read from the same row, so one query serves them.
const settingsPrefs =
  supabase && user
    ? (
        await supabase
          .from("profiles")
          .select("reminders_enabled, analytics_opt_out, openai_api_key_ciphertext, openai_api_key_hint")
          .eq("owner_id", user.id)
          .maybeSingle()
      ).data
    : null;
const remindersEnabled = settingsPrefs?.reminders_enabled ?? true;
// Inverted here because the column is negative and the switch is positive: no
// profile row, or a row predating F-06, means analytics are on -- the same
// default the wrapper's consent read applies.
const analyticsEnabled = !(settingsPrefs?.analytics_opt_out ?? false);
// S-17: no profile row reads as no key on file, same as an absent ciphertext.
const ownerKey = await resolveOwnerKey({
  openai_api_key_ciphertext: settingsPrefs?.openai_api_key_ciphertext ?? null,
});
const apiKeyHint = settingsPrefs?.openai_api_key_hint ?? null;
const apiKeyUnreadable = ownerKey.source === "app" && "unreadable" in ownerKey;
---

<AppShell title="Ustawienia" profileName={profileName}>
  <div class="mb-6">
    <h1 class="font-display text-display-sm text-foreground">Ustawienia</h1>
  </div>

  <div class="max-w-xl space-y-8">
    <section>
      <h2 class="text-foreground mb-3 text-sm font-semibold">Twój profil</h2>
      <div class="border-border bg-card text-card-foreground shadow-card rounded-2xl border p-8">
        <p class="text-muted-foreground mb-4">
          Imię, data urodzenia, kontekst życiowy i rytm kontaktu — to, z czego korzysta podpowiedź AI.
        </p>
        <a href="/profile" class:list={buttonVariants({})}>Edytuj profil</a>
      </div>
    </section>

    <section>
      <h2 class="text-foreground mb-3 text-sm font-semibold">Konto</h2>
      <div class="border-border bg-card text-card-foreground shadow-card space-y-8 rounded-2xl border p-8">
        <EmailChangeForm currentEmail={user?.email ?? ""} client:load />
        <div class="border-border border-t pt-8">
          <PasswordChangeForm client:load />
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-foreground mb-3 text-sm font-semibold">Przypomnienia</h2>
      <div class="border-border bg-card text-card-foreground shadow-card rounded-2xl border p-8">
        <RemindersSection remindersEnabled={remindersEnabled} client:load />
      </div>
    </section>

    <section>
      <h2 class="text-foreground mb-3 text-sm font-semibold">Klucz OpenAI</h2>
      <div class="border-border bg-card text-card-foreground shadow-card rounded-2xl border p-8">
        <ApiKeySection hint={apiKeyHint} unreadable={apiKeyUnreadable} client:load />
      </div>
    </section>

    <section>
      <h2 class="text-foreground mb-3 text-sm font-semibold">Prywatność</h2>
      <div class="border-border bg-card text-card-foreground shadow-card rounded-2xl border p-8">
        <AnalyticsSection analyticsEnabled={analyticsEnabled} client:load />
      </div>
    </section>

    <section>
      <h2 class="text-destructive mb-3 text-sm font-semibold">Strefa zagrożenia</h2>
      <div class="border-destructive/30 bg-card text-card-foreground shadow-card rounded-2xl border p-8">
        <DeleteDataSection client:load />
      </div>
    </section>
  </div>
</AppShell>
