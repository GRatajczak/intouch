---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import SignUpForm from "@/components/auth/SignUpForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zarejestruj się">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-2xl border p-8">
      <div class="mb-6 flex flex-col items-center gap-3">
        <Logo size={32} />
        <h1 class="font-display text-display-sm text-foreground text-center">Zarejestruj się</h1>
      </div>
      <SignUpForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Masz już konto?{" "}
        <a href="/auth/signin" class="text-accent-foreground cursor-pointer hover:underline"> Zaloguj się </a>
      </p>
    </div>
  </div>
</Layout>
