---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
---

<Layout title="Sprawdź swoją skrzynkę e-mail">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div
      class="border-border bg-card text-card-foreground shadow-card w-full max-w-sm rounded-2xl border p-8 text-center"
    >
      <div class="mb-4 flex justify-center">
        <Logo size={32} />
      </div>
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="font-display text-display-sm text-foreground mb-3">Sprawdź swoją skrzynkę e-mail</h1>
      <p class="text-muted-foreground mb-6">
        Jeśli podany adres jest powiązany z kontem, wysłaliśmy na niego link do zresetowania hasła. Kliknij go, aby
        ustawić nowe hasło.
      </p>
      <a href="/auth/signin" class="text-accent-foreground cursor-pointer text-sm hover:underline">
        Powrót do logowania
      </a>
    </div>
  </div>
</Layout>
