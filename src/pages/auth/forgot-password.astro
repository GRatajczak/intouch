---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import ForgotPasswordForm from "@/components/auth/ForgotPasswordForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zapomniałeś hasła?">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-card-foreground shadow-card w-full max-w-sm rounded-2xl border p-8">
      <div class="mb-6 flex flex-col items-center gap-3">
        <Logo size={32} />
        <h1 class="font-display text-display-sm text-foreground text-center">Zapomniałeś hasła?</h1>
        <p class="text-muted-foreground text-center text-sm">
          Podaj adres e-mail powiązany z kontem, a wyślemy Ci link do zresetowania hasła.
        </p>
      </div>
      <ForgotPasswordForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Przypomniałeś sobie hasło?{" "}
        <a href="/auth/signin" class="text-accent-foreground cursor-pointer hover:underline"> Zaloguj się </a>
      </p>
    </div>
  </div>
</Layout>
