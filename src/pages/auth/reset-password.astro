---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { ServerError } from "@/components/auth/ServerError";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Ustaw nowe hasło">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-card-foreground shadow-card w-full max-w-sm rounded-2xl border p-8">
      <div class="mb-6 flex flex-col items-center gap-3">
        <Logo size={32} />
        <h1 class="font-display text-display-sm text-foreground text-center">Ustaw nowe hasło</h1>
      </div>
      {
        error && (
          <div class="mb-4 flex flex-col gap-2">
            <ServerError message={error} />
            <a
              href="/auth/forgot-password"
              class="text-accent-foreground cursor-pointer text-center text-sm hover:underline"
            >
              Poproś o nowy link
            </a>
          </div>
        )
      }
      <ResetPasswordForm client:load />
    </div>
  </div>
</Layout>
