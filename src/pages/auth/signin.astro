---
import Layout from "@/layouts/Layout.astro";
import Logo from "@/components/Logo.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Zaloguj się">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-card-foreground w-full max-w-sm rounded-2xl border p-8">
      <div class="mb-6 flex flex-col items-center gap-3">
        <Logo size={32} />
        <h1 class="font-display text-display-sm text-foreground text-center">Zaloguj się</h1>
      </div>
      <SignInForm serverError={error} client:load />
      <p class="text-muted-foreground mt-4 text-center text-sm">
        Nie masz konta?{" "}
        <a href="/auth/signup" class="text-accent-foreground cursor-pointer hover:underline"> Zarejestruj się </a>
      </p>
    </div>
  </div>
</Layout>
