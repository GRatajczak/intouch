---
import AppShell from "@/components/layout/AppShell.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

let initialValues;
let profileName: string | null = null;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    const { data: row } = await supabase.from("profiles").select("*").eq("owner_id", user.id).maybeSingle();
    if (row) {
      profileName = row.name;
      initialValues = {
        name: row.name,
        birthDate: row.birth_date,
        lifeContext: row.life_context,
        weeklyTimeBudget: row.weekly_time_budget ?? undefined,
        preferredChannels: row.preferred_channels,
        availabilityWindows: row.availability_windows,
      };
    }
  }
}
---

<AppShell title="Twój profil" profileName={profileName}>
  <div class="mb-6">
    <h1 class="font-display text-display-sm text-foreground">Twój profil</h1>
  </div>

  <div class="mx-auto max-w-xl lg:mx-0">
    <ProfileForm initialValues={initialValues} client:load />
  </div>
</AppShell>
