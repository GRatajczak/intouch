---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";

const { user } = Astro.locals;
---

<Layout title="Panel">
  <div class="bg-background flex min-h-screen items-center justify-center p-4">
    <div class="border-border bg-card text-card-foreground rounded-2xl border p-8 text-center">
      <h1 class="font-display text-display-md mb-4">Panel</h1>
      <p class="text-muted-foreground">
        Witaj, <span class="text-foreground font-semibold">{user?.email}</span>
      </p>
      <p class="text-text-tertiary mt-2 text-sm">Ta strona jest dostępna tylko dla zalogowanych użytkowników.</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <Button type="submit" variant="outline"> Wyloguj się </Button>
      </form>
    </div>
  </div>
</Layout>
