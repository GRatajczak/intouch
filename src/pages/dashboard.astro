---
import AppShell from "@/components/layout/AppShell.astro";
import { HierarchyView } from "@/components/hierarchy/HierarchyView";
import { HierarchyEmptyState } from "@/components/hierarchy/HierarchyEmptyState";
import { createClient } from "@/lib/supabase";
import { loadProfileName } from "@/lib/shell-summary";
import { loadLatestRanking, isStale } from "@/lib/ranking/store";

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let hasProfile = false;
let peopleCount = 0;
let ranking = null;

if (supabase && user) {
  // No-profile is reachable: middleware.ts gates only /people on profile
  // existence, so a signed-up user who skipped /profile still lands here.
  const [{ data: profile }, { count }] = await Promise.all([
    supabase.from("profiles").select("owner_id").eq("owner_id", user.id).maybeSingle(),
    supabase.from("people").select("*", { count: "exact", head: true }).eq("owner_id", user.id),
  ]);
  hasProfile = !!profile;
  peopleCount = count ?? 0;

  if (hasProfile && peopleCount > 0) {
    ranking = await loadLatestRanking(supabase, user.id);
  }
}

const staleOnLoad = isStale(ranking);

// peopleCount now costs nothing extra since the query above already runs --
// this replaces AppShell.astro's prior comment justifying its omission here.
const profileName = await loadProfileName(Astro.request.headers, Astro.cookies, user?.id);
---

<AppShell title="Dziś" profileName={profileName} peopleCount={peopleCount}>
  <h1 class="font-display text-display-sm text-foreground mb-6">Kto teraz czeka na Twój telefon</h1>

  {
    !hasProfile ? (
      <HierarchyEmptyState variant="no-profile" />
    ) : peopleCount === 0 ? (
      <HierarchyEmptyState variant="no-people" />
    ) : (
      <HierarchyView initialRanking={ranking} staleOnLoad={staleOnLoad} client:load />
    )
  }
</AppShell>
