---
import AppShell from "@/components/layout/AppShell.astro";
import PersonForm from "@/components/people/PersonForm";
import { loadProfileName } from "@/lib/shell-summary";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const profileName = await loadProfileName(Astro.request.headers, Astro.cookies, user?.id);
---

<AppShell title="Dodaj osobę" profileName={profileName}>
  <div class="flex h-full min-h-0 flex-col">
    <PersonForm serverError={error} client:load />
  </div>
</AppShell>
