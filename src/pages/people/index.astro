---
import AppShell from "@/components/layout/AppShell.astro";
import { Button } from "@/components/ui/button";
import { EmptyState } from "@/components/people/EmptyState";
import { PersonCard } from "@/components/people/PersonCard";
import { createClient } from "@/lib/supabase";
import { loadProfileName } from "@/lib/shell-summary";

const { user } = Astro.locals;

let people: Awaited<ReturnType<typeof fetchPeople>> = [];

async function fetchPeople() {
  if (!user) return [];
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return [];
  const { data } = await supabase
    .from("people")
    .select("*")
    .eq("owner_id", user.id)
    .order("weight", { ascending: false })
    .order("created_at", { ascending: true });
  return data ?? [];
}

people = await fetchPeople();

// This page already has the array in scope, so the sidebar's count line costs
// nothing extra here.
const profileName = await loadProfileName(Astro.request.headers, Astro.cookies, user?.id);
---

<AppShell title="Twoi bliscy" profileName={profileName} peopleCount={people.length}>
  <div class="mb-6 flex items-center justify-between">
    <h1 class="font-display text-display-sm text-foreground">Twoi bliscy</h1>
    {
      people.length > 0 && (
        <Button asChild>
          <a href="/people/new">Dodaj osobę</a>
        </Button>
      )
    }
  </div>

  {
    people.length === 0 ? (
      <EmptyState />
    ) : (
      <div class="space-y-3">
        {people.map((person) => (
          <PersonCard person={person} />
        ))}
      </div>
    )
  }
</AppShell>
