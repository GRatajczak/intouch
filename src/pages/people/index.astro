---
import Layout from "@/layouts/Layout.astro";
import { Button } from "@/components/ui/button";
import { EmptyState } from "@/components/people/EmptyState";
import { PersonCard } from "@/components/people/PersonCard";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;

let people: Awaited<ReturnType<typeof fetchPeople>> = [];

async function fetchPeople() {
  if (!user) return [];
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) return [];
  const { data } = await supabase
    .from("people")
    .select("*")
    .eq("owner_id", user.id)
    .order("weight", { ascending: false })
    .order("created_at", { ascending: true });
  return data ?? [];
}

people = await fetchPeople();
---

<Layout title="Twoi bliscy">
  <div class="bg-background min-h-screen p-4 py-8">
    <div class="mx-auto w-full max-w-2xl">
      <div class="mb-6 flex items-center justify-between">
        <h1 class="font-display text-display-sm text-foreground">Twoi bliscy</h1>
        {
          people.length > 0 && (
            <Button asChild>
              <a href="/people/new">Dodaj osobę</a>
            </Button>
          )
        }
      </div>

      {
        people.length === 0 ? (
          <EmptyState />
        ) : (
          <div class="space-y-3">
            {people.map((person) => (
              <PersonCard person={person} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</Layout>
