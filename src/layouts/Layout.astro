---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { Toaster } from "@/components/layout/Toaster";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** Meta description and `og:description`. Omitted entirely when absent. */
  description?: string;
  /** Absolute or site-relative social card image. No default asset exists yet. */
  ogImage?: string;
}

const { title = "InTouch", description, ogImage } = Astro.props;

// `site` in astro.config.mjs makes this absolute, which og:url requires.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {
      /* Social card tags ride along with `description`: a page that opts into one
         is a page meant to be shared. Auth-gated screens pass nothing and so emit
         nothing new. */
      description && (
        <>
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:type" content="website" />
          <meta property="og:url" content={canonicalUrl} />
          {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
          <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
        </>
      )
    }
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>Uwaga:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer" class="cursor-pointer">
                {cfg.docsLabel ?? "Dokumentacja"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <Toaster client:load />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
