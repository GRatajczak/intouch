# Committed on purpose, unlike every other env file in this repo.
#
# Astro's env plugin inlines `astro:env/server` values at Vite config-resolution
# time, so a test that imports src/lib/supabase.ts needs SUPABASE_URL and
# SUPABASE_KEY to exist before any test file runs. Vitest's default mode is
# "test", so Astro's loadEnv picks this file up automatically. Setting the same
# values from a setupFile would be too late.
#
# Both values below are the fixed constants of a local `supabase start` stack --
# the same anon key every Supabase developer on earth has. They are not secrets,
# which is why committing them is safe and why `.gitignore` (which lists `.env`
# and `.env.production` literally) is left alone.
#
# NEVER put a hosted-project URL or key in this file. The RLS fixtures create and
# delete real users; pointed at a hosted project they would do that to production.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# S-04's reminder sweep runs with no signed-in user, so it reaches Supabase
# through a service-role client (src/lib/supabase-admin.ts). This is the local
# stack's own demo service_role key -- the same fixed constant every Supabase
# developer has, paired with the demo anon key above. It grants nothing beyond
# the throwaway container this file already points at, which is why committing
# it is safe under exactly the rule stated above: never point this file at a
# hosted project. A real service-role key belongs in .dev.vars and Workers
# Secrets, never here.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
REMINDER_FROM=InTouch <przypomnienia@get-in-touch.pl>
APP_BASE_URL=http://localhost:4321

# S-17's BYOK encryption secret. A throwaway value generated purely for the
# test suite (`openssl rand -base64 32`) -- it exists only to give
# tests/unit/api-key-crypto.test.ts a real 32-byte key to round-trip against,
# and grants access to nothing. Never a value used against a hosted project.
OPENAI_KEY_ENCRYPTION_KEY=VFfGhuP+wj2RXgrrEKrcxPMwFRmo4YRUjRWqF6f2vmI=
